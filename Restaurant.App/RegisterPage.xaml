<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Restaurant.App.RegisterPage"
             Title="Create Account"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
            
            <Label Text="Sign Up" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333333"/>
            <Label Text="Please fill out the fields below to register." FontSize="14" HorizontalOptions="Center" TextColor="#666666" Margin="0,0,0,10"/>

            <!-- Profile Info Section -->
            <Entry x:Name="FullNameEntry" Placeholder="Full Name" Keyboard="Text" TextColor="Black" PlaceholderColor="Gray"/>
            <Entry x:Name="PhoneEntry" Placeholder="Phone Number" Keyboard="Telephone" TextColor="Black" PlaceholderColor="Gray"/>
            <Entry x:Name="AddressEntry" Placeholder="Address" Keyboard="Text" TextColor="Black" PlaceholderColor="Gray"/>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>

            <!-- Account Info Section -->
            <Entry x:Name="EmailEntry" Placeholder="Email Address" Keyboard="Email" TextColor="Black" PlaceholderColor="Gray"/>
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" TextColor="Black" PlaceholderColor="Gray"/>
            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm Password" IsPassword="True" TextColor="Black" PlaceholderColor="Gray"/>

            <ActivityIndicator x:Name="RegisterLoading" IsRunning="False" Color="Orange" VerticalOptions="Center" HorizontalOptions="Center"/>

            <Button Text="Create Account" Clicked="OnRegisterClicked" BackgroundColor="Orange" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="25" Margin="0,15,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>