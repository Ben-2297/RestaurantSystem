<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand Palette from your Screenshots -->
    <Color x:Key="PrimaryBrand">#2A4B7C</Color>
    <Color x:Key="AccentCyan">#3CD3FF</Color>
    <Color x:Key="AppBackground">#E1E1E1</Color>
    <Color x:Key="ElementGray">#D1D1D1</Color>
    <Color x:Key="TextDark">#111111</Color>
    <Color x:Key="TextMuted">#555555</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryBrand}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource AppBackground}" />
</ResourceDictionary>