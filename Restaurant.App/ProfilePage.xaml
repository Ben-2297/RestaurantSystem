<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Restaurant.App.ProfilePage"
             Title="My Profile"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            
            <!-- Summary Header Details -->
            <Label x:Name="NameLabel" Text="Customer Name" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
            <Label x:Name="EmailLabel" Text="user@email.com" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>

            <!-- Verification Alert Badge -->
            <Border x:Name="StatusBadge" Padding="15,10" StrokeShape="RoundRectangle 10" HorizontalOptions="Center" Margin="0,5">
                <Label x:Name="StatusLabel" Text="Unverified Account" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
            </Border>

            <BoxView HeightRequest="1" Color="#E0E0E0"/>

            <!-- User Data Details Display -->
            <Label Text="Profile Details" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
            
            <Label Text="Phone Number" FontSize="12" TextColor="Gray"/>
            <Entry x:Name="PhoneEntry" IsReadOnly="True" TextColor="Black"/>
            
            <Label Text="Address" FontSize="12" TextColor="Gray"/>
            <Entry x:Name="AddressEntry" IsReadOnly="True" TextColor="Black"/>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>

            <Button Text="View Order History"
                    Clicked="OnViewOrderHistoryClicked"
                    BackgroundColor="#0f766e"
                    TextColor="White"
                    CornerRadius="10"/>

            <Button Text="View Payment History"
                    Clicked="OnViewPaymentHistoryClicked"
                    BackgroundColor="#2563eb"
                    TextColor="White"
                    CornerRadius="10"/>

            <!-- Change Password Component Area -->
            <Label Text="Change Password" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
            <Entry x:Name="OldPasswordEntry" Placeholder="Current Password" IsPassword="True" PlaceholderColor="Gray" TextColor="Black"/>
            <Entry x:Name="NewPasswordEntry" Placeholder="New Password" IsPassword="True" PlaceholderColor="Gray" TextColor="Black"/>
            
            <Button Text="Update Password" 
                    Clicked="OnChangePasswordClicked" 
                    BackgroundColor="DarkSlateGray" 
                    TextColor="White" 
                    CornerRadius="10"/>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>

            <!-- Log Out Action Button -->
            <Button Text="Log Out" 
                    Clicked="OnLogoutClicked" 
                    BackgroundColor="#C82828" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>